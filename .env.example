# Copy to .env (loaded automatically via dotenvy). All values are optional.

# mock | serial
S2M_TRANSPORT=mock

# Unix socket Moonraker connects to (klippy_uds_address)
S2M_UDS=/tmp/klippy_uds

# G-code directory (must match Moonraker's gcodes / virtual_sdcard path)
S2M_GCODE_DIR=./gcodes

# Real printer only:
# S2M_SERIAL_PORT=/dev/serial/by-id/usb-XXXX
# S2M_BAUD=115200          # omit to autodetect

# Advertised limits
S2M_BED_SIZE=220,220,250
S2M_MAX_VELOCITY=300
S2M_MAX_ACCEL=3000

# Logging (default logs every serial line; use plain "info" for a quieter log)
RUST_LOG=info,serial2moon=debug

# Log file (only with S2M_LOG_DIR): rotate at this size (MB), keep this many older logs
# gzip-compressed (serial2moon.log.1.gz = newest; 0 = no history)
# S2M_LOG_DIR=./logs
# S2M_LOG_MAX_SIZE_MB=20
# S2M_LOG_MAX_FILES=10
