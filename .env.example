# uart2moon Environment Configuration

# Path to the Unix socket file (where moonraker expects to find Klipper)
SOCKET_PATH=/tmp/printer

# Serial port device (e.g., /dev/ttyUSB0, /dev/ttyACM0)
DEVICE=/dev/ttyUSB0

# Baud rate for serial communication
BAUD_RATE=115200

# Enable verbose logging (true/false)
VERBOSE=false

# Test mode - run without connecting to serial device (true/false)
TEST_MODE=false