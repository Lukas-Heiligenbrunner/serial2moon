[Unit]
Description=serial2moon (Marlin <-> Moonraker bridge) container stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/serial2moon
ExecStart=/opt/serial2moon/start.sh

[Install]
WantedBy=multi-user.target
